{
  "name": "blockbook-openapi-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:spec": "redocly lint ../../openapi.yaml --config redocly.yaml",
    "generate": "openapi-typescript ../../openapi.yaml -o .generated/blockbook.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx src/e2e.ts"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "brace-expansion@2": "2.1.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.51.2",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "https-proxy-agent": "7.0.6",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "ws": "8.22.1",
    "yaml": "2.9.1"
  }
}
